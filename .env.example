# Author: Anil Kalisetti
# Copy to .env for local runs (never commit .env). In CI, inject these as secrets / variables.
# Precedence: CLI flag > environment variable > config/environments/<TEST_ENV>.yaml > code default.

# --- Environment ------------------------------------------------------------
TEST_ENV=qa
# BASE_UI_URL=https://www.saucedemo.com
# BASE_API_URL=https://jsonplaceholder.typicode.com
# HTTPBIN_URL=https://httpbingo.org

# --- Browser / execution target --------------------------------------------
BROWSER=chrome                  # chrome | firefox | edge | safari (safari: macOS or cloud only)
HEADLESS=true
# local | remote (any Selenium Grid) | saucelabs | browserstack | lambdatest
EXECUTION_MODE=local

# --- Remote grid / cloud platforms (placeholders: fill in to use) ----------
GRID_URL=                       # remote: http://grid:4444/wd/hub ; cloud modes have sensible defaults
GRID_USERNAME=                  # or SAUCE_USERNAME / BROWSERSTACK_USERNAME / LT_USERNAME
GRID_ACCESS_KEY=                # or SAUCE_ACCESS_KEY / BROWSERSTACK_ACCESS_KEY / LT_ACCESS_KEY
PLATFORM_NAME=Windows 11
BROWSER_VERSION=latest

# --- Self-healing locators (docs/SELF_HEALING.md) ----------------------------
# LOCATOR_HEALING=true            # --no-healing turns it off for one run
# HEAL_THRESHOLD=0.8              # minimum similarity (0-1) to accept a look-alike element
# HEAL_MARGIN=0.1                 # best match must beat the runner-up by this much
# HEAL_AFTER=3                    # seconds to wait for the original locator before healing
# FAIL_ON_HEAL=false              # true = exit non-zero if anything healed (release gate)
# --- Reports ---------------------------------------------------------------
# REPORTS_DIR=reports
# SCREENSHOT_POLICY=on_failure    # on_failure | always | never
# PASS_RATE_GREEN=95
# PASS_RATE_AMBER=80
# --- Database ---------------------------------------------------------------
DB_URL=sqlite:///reports/sample_test.db
# Real example: postgresql+psycopg2://qa_user:***@db.qa.internal:5432/orders

# --- Jira (defect auto-creation) -------------------------------------------
JIRA_ENABLED=false
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_USER_EMAIL=you@your-company.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=QA
